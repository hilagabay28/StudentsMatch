<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RegisterActivity"
    android:background="@drawable/regpage"
    android:orientation="vertical"
    android:layout_gravity="center"
    android:layoutDirection="ltr">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imageView"
            android:layout_width="100dp"
            android:layout_height="66dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/profilemain"
            tools:ignore="MissingClass" />

        <ImageView
            android:id="@+id/imgviewtest"
            android:layout_width="180dp"
            android:layout_height="300dp"
            android:src="@drawable/removebgregister"
            android:layout_gravity="center"
            android:layout_marginStart="75dp"
            android:layout_marginTop="-30dp"
            />


    </LinearLayout>





    <TextView
        android:id="@+id/login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sign up"
        android:textAlignment="center"
        android:textSize="50sp"
        android:textColor="#1D8E95"
        android:fontFamily="@font/suezoneregular"
        android:layout_marginTop="-70dp"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layoutDirection="ltr"
        android:gravity="center"
        android:layout_marginTop="20dp"
        >



        <EditText
            android:id="@+id/username"
            android:layout_width="320dp"
            android:layout_height="50dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="0dp"
            android:background="@drawable/custom_edittext"
            android:drawablePadding="8dp"
            android:hint="user name"
            android:padding="8dp"
            android:textColor="#54A39C"
            android:textColorHighlight="@color/cardview_dark_background"
            android:drawableLeft="@drawable/baseline_person_24"
            />


    </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layoutDirection="ltr"
        android:gravity="center"
        android:layout_marginTop="20dp"
        >




        <EditText
            android:id="@+id/useremail"
            android:layout_width="320dp"
            android:layout_height="50dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="0dp"
            android:background="@drawable/custom_edittext"
            android:drawablePadding="8dp"
            android:hint="email"
            android:padding="8dp"
            android:textColor="#54A39C"
            android:textColorHighlight="@color/cardview_dark_background"
            android:drawableLeft="@drawable/baseline_local_post_office_24"/>


    </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layoutDirection="ltr"
        android:gravity="center"
        android:layout_marginTop="20dp"
        >




        <EditText
            android:id="@+id/useryear"
            android:layout_width="320dp"
            android:layout_height="50dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="0dp"
            android:background="@drawable/custom_edittext"
            android:drawablePadding="8dp"
            android:hint="birth date"
            android:padding="8dp"
            android:textColor="#54A39C"
            android:textColorHighlight="@color/cardview_dark_background"
            android:drawableLeft="@drawable/baseline_list_24"/>


    </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layoutDirection="ltr"
        android:gravity="center"
        android:layout_marginTop="20dp"
        >




        <EditText
            android:id="@+id/userphone"
            android:layout_width="320dp"
            android:layout_height="50dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="0dp"
            android:background="@drawable/custom_edittext"
            android:drawablePadding="8dp"
            android:hint="phone"
            android:padding="8dp"
            android:textColor="#54A39C"
            android:textColorHighlight="@color/cardview_dark_background"
            android:drawableLeft="@drawable/baseline_add_call_24"/>


    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layoutDirection="ltr"
        android:gravity="center"
        android:layout_marginTop="20dp"
        >




        <EditText
            android:id="@+id/userpassword"
            android:layout_width="320dp"
            android:layout_height="50dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="0dp"
            android:background="@drawable/custom_edittext"
            android:drawablePadding="8dp"
            android:hint="password"
            android:padding="8dp"
            android:textColor="#54A39C"
            android:inputType="textPassword"
            android:textColorHighlight="@color/cardview_dark_background"
            android:drawableLeft="@drawable/baseline_password_24"/>


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:layout_marginTop="15dp"
        android:gravity="center"
        android:orientation="horizontal">


        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/regbuttom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:backgroundTint="#ECCDB8"
            android:fontFamily="@font/rasaregular"
            android:text="sign up"
            android:textColor="@color/black"
            android:textSize="20dp"
            android:layout_marginStart="23dp"
            />

        <Space
            android:layout_width="20dp"
            android:layout_height="match_parent" />
    </LinearLayout>
</LinearLayout>
